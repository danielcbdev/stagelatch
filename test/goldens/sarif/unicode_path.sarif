{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "stagelatch",
          "version": "0.1.0",
          "rules": [
            {
              "id": "format/unformatted",
              "shortDescription": {
                "text": "A Dart file is not formatted."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "format/unformatted",
          "level": "error",
          "message": {
            "text": "File is not formatted."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/caf%C3%A9%20menu/a.dart",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
